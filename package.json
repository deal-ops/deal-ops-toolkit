{
  "name": "deal-ops-toolkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings --ignore-pattern site/site.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "oracle:selfcheck": "python3 scripts/oracle/selfcheck.py",
    "coverage:check": "vitest run --reporter=json --outputFile=test-report.json && node scripts/check-coverage.mjs test-report.json",
    "bench": "BENCH=1 vitest run src/lib/perf.test.ts",
    "mutation": "node scripts/mutation-check.mjs",
    "e2e": "playwright test",
    "e2e:check": "playwright test && node scripts/check-e2e.mjs e2e-report.json",
    "site:build": "rolldown site-src/site.js -f iife -m -o site/site.js",
    "site:check": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
